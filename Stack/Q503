//Leetcode ques-Next Greater element II

class Solution {
    public int[] nextGreaterElements(int[] nums) {
         int n=nums.length;

         int[]ans=new int[n];

         Arrays.fill(ans,-1);//poore array ko starting se hi -1 se fill kr diya

         Stack<Integer>st=new Stack<>();

         for(int i=0;i<2*n;i++){//circular array
            
            int curr=nums[i%n];//array will go beyond size

            while(st.size()!=0 && nums[st.peek()]<curr){
                ans[st.pop()]=curr;
                            }
                            if(i<n){
                                st.push(i);
                            }
         }
         return ans;
    }
}
