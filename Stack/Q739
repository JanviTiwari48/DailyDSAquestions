//Leetcode ques-Daily temperatures

class Solution {
    public int[] dailyTemperatures(int[] temp) {
    int n=temp.length;
       int[] ans = new int[n];
        Stack<Integer>st=new Stack<>();
        
        for(int i=0;i<n;i++){
            while(st.size()>0 && temp[i]>temp[st.peek()] ){

                int idx=st.pop();
                 ans[idx]=i-idx;
           
            }
            st.push(i);
        }
        return ans;
    }
}
