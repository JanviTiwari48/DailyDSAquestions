class Solution {
    public String removeDuplicateLetters(String s) {
        
        int freq[]=new int[26];
        
        for(char ch:s.toCharArray()){
            freq[ch-'a']++;
        }

        boolean[] visited=new boolean[26];//keep track of character already in stack

        Stack<Character>st=new Stack<>();

         for(char ch:s.toCharArray()){

            freq[ch-'a']--;//dec the frequency as we process them

            if(visited[ch-'a'])continue;//already present in stack skip it

                                                //if again visited
         while(st.size()>0 && st.peek()>ch && freq[st.peek()-'a']>0){

            visited[st.pop()-'a']=false;
         }

          // Push current character
            st.push(ch);
            visited[ch - 'a'] = true;
         }
        //build ans
        StringBuilder ans=new StringBuilder();

        while(st.size()>0){
            ans.append(st.pop());
        }
        return ans.reverse().toString();
    }
}
