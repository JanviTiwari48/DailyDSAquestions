//leetcode ques- Maximum Nesting Depth of the Parentheses

class Solution {
    public int maxDepth(String s) {
       
     Stack<Character>st=new Stack<>();
     int maxdepth=0;
    
    for(int i=0;i<s.length();i++){
        char ch=s.charAt(i);

        if(ch=='('){
            st.push(ch);
            maxdepth=Math.max(maxdepth,st.size());
        }else if(ch==')'){
            st.pop();
        }
    }
    return maxdepth;
    }
}
