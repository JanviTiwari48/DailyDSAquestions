class Solution {
    public double minPrice(int[] prices, int[] discounts) {

        Arrays.sort(prices);
        Arrays.sort(discounts);
        int n=prices.length;
        int m=discounts.length;

        int k=Math.min(n,m);
        double total=0;
   //pair largest price with largest discount
        for(int i=0;i<k;i++){
              int p=prices[n-1-i];
            int d=discounts[m-1-i];

            total=total+p*(100.0-d)/100.0;
        }
        //remaining prices get no discount
        for(int i=0;i<n-k;i++){
            total=total+prices[i];
        }
        return total;
    }
}
