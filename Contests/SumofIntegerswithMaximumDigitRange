class Solution {
    public int maxDigitRange(int[] nums) {

     int max=-1;
        int sum=0;
        for(int n:nums){
            int temp=n;
            int maxDigit=0;
            int minDigit=9;

            
            while(temp>0){
                int digit=temp%10;
                maxDigit=Math.max(maxDigit,digit);
                minDigit=Math.min(minDigit,digit);
                temp=temp/10;
            }
            
            int range=maxDigit-minDigit;
            if(range>max){
                max=range;
            sum=n;
            }else if(range==max){
                sum=sum+n;
            }
        }

return sum;
 
    }
}
