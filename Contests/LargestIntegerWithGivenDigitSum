class Solution {
    public int largestInteger(int n, int s) {
//for the largest no leftmost must be 9
        if(s>9*n)return -1;

        if(s==0)return 0;

        int ans=0;
        for(int i=0;i<n;i++){
            int digit=Math.min(9,s);
            ans=ans*10+digit;
            s=s-digit;
        }
        return ans;
    }
}
