Maximum Average Subarray I
class Solution {
    public double findMaxAverage(int[] arr, int k) {
         int i=0;//start
       int j=0;//end
       
       int sum=0;
       int max=Integer.MIN_VALUE;
       
       
       while(j<arr.length){
           
          sum=sum+arr[j];
          
          if(j-i+1<k)j++;
          else if(j-i+1==k){
              
              max=Math.max(max,sum);
              
              sum=sum-arr[i];
              i++;
              j++;
          }
       }
       return (double) max/k;
    }
}
