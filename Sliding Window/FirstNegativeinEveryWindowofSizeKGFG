class Solution {
    static List<Integer> firstNegInt(int arr[], int k) {
        // write code here
        
        int i=0;
        int j=0;
        ArrayList<Integer>ans=new ArrayList<>();
        Queue<Integer>q=new LinkedList<>();
        
        while(j<arr.length){
            if(arr[j]<0)q.add(arr[j]);
            
            if(j-i+1<k)j++;
            else if(j-i+1==k){
                
                if(q.size()==0)ans.add(0);
                else ans.add(q.peek());
               
            
            if(q.size()>0 && arr[i]==q.peek())
            q.remove();
            
        
            i++;
            j++;
        }
        }
        return ans;
    }
}
