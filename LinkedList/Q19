//Leetcode ques-Remove nth node from end of list

class Solution {
    public ListNode removeNthFromEnd(ListNode head, int n) {
        ListNode slow=head;
        ListNode fast=head;
         for(int i=1;i<=n;i++){
            fast=fast.next;
            
         }
           if(fast == null){
            return head.next;
        }
         while(fast.next!=null){//fast ko tail tk lejana h
            slow=slow.next;
            fast=fast.next;
         }
          slow.next=slow.next.next;
             return head;
    }
 
}
