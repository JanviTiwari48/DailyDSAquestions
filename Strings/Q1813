//Leetcode ques-Sentence similarity 3

class Solution {
    public boolean areSentencesSimilar(String sentence1, String sentence2) {

        String[] a = sentence1.split(" ");
        String[] b = sentence2.split(" ");

        // make a smaller
        if (a.length > b.length) {
            String[] temp = a;
            a = b;
            b = temp;
        }

        int i = 0;

        // prefix match
        while (i < a.length && a[i].equals(b[i])) {
            i++;
        }

        int j = 0;

        // suffix match
        while (j < a.length - i &&
               a[a.length - 1 - j].equals(b[b.length - 1 - j])) {

            j++;
        }

        return i + j == a.length;
    }
}
