//leetcode ques-Make string a subsequence using cyclic increaments
class Solution {
    public boolean canMakeSubsequence(String str1, String str2) {
        int i=0;
        int j=0;

        while(i<str1.length() && j<str2.length()){
       char curr=str1.charAt(i);
            char next;
           if(curr =='z'){
            next='a';
           }else{
            next=(char)(curr+1);

           }
           if(str2.charAt(j)==curr|| str2.charAt(j)==next){
            j++;
           }
           i++;
        }
        return j==str2.length();
    }
}
