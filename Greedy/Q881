class Solution {
    public int numRescueBoats(int[] people, int limit) {
        
        Arrays.sort(people);

        int left=0;//light
        int right=people.length-1;//heavy
        int boats=0;

        while(left<=right){

            if(people[left]+people[right]<=limit)//same boat
                left++;
            
                right--;//seperate boat for heavy person
                boats++;
            
        }
        return boats;
    }
}
