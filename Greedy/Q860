Lemonade Change

class Solution {
    public boolean lemonadeChange(int[] bills) {
        
        int five=0;
        int ten=0;

        for(int i=0;i<bills.length;i++){
            if(bills[i]==5)five++;

          else  if(bills[i]==10){
                
                if(five==0)return false;

                five--;
                ten++;
          }
          else{//20
               if(ten>0 && five>0){//10+5 as change
                ten--;
                five--;
              }else if(five>=3){// three 5 as change 5+5+5
                five=five-3;
              }else return false;
               }
       
        }
        return true;
    }
}
