// Non-overlapping Intervals

class Solution {
    public int eraseOverlapIntervals(int[][] intervals) {
        
   Arrays.sort(intervals,(a,b)->a[1]-b[1]);//comaprator comparing end time of all intervals

   int count=1;
   int prevEnd=intervals[0][1];//[1,2]=2;

   for(int i=1;i<intervals.length;i++){
    if(intervals[i][0]>=prevEnd){//[2,3]....2>=2 ..true
        count++;
        prevEnd=intervals[i][1];//.....3
    }
   }
return intervals.length-count;//4-3

    }
}
