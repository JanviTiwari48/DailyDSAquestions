//Leetcode -Partiton array according to given pivot
class Solution {
    public int[] pivotArray(int[] nums, int pivot) {
        int n=nums.length;
        int[] ans =new int[n];
        int l=0;
        int r=n-1;

        for(int i=0;i<n;i++){
            if(nums[i]<pivot){
                ans[l]=nums[i];
                l++;
            }
        }
for(int i=n-1;i>=0;i--){
    if(nums[i]>pivot){
        
            ans[r]=nums[i];
            r--;
        }
    }
    while(l<=r){
        ans[l]=pivot;
    }
return ans;
    }
}
