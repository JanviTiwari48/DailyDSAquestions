class Solution {
    public int smallestNumber(int n, int t) {
     
     while(true){
        int ans=productOfDigits(n);

        if(ans%t==0)return n;
        n++;//try next number
     }
    }
    private int productOfDigits(int num){
        int product=1;
        while(num>0){
            product=product*(num%10);
            num=num/10;
        }
        return product;
    }
}
