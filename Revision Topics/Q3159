Find Occurances of an element in an array

class Solution {
    public int[] occurrencesOfElement(int[] nums, int[] queries, int x) {
        
        ArrayList<Integer>list=new ArrayList<>();

        for(int i=0;i<nums.length;i++){
            if(nums[i]==x)list.add(i);//0 2 
        }
        int[] ans=new int[queries.length];

        for(int i=0;i<queries.length;i++){// 1 3 2 4
            int k=queries[i];
            if(k<=list.size()){
             ans[i]=list.get(k-1);//kth occurance chahiye k-1 kyunki list index starts from 0     (0 2)
       }else{
    ans[i]=-1;//0 -1 2 -1
}
        }
return ans;
    }
}
