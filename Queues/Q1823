//Leetcode ques-Find the Winner of the Circular Game

class Solution {
    public int findTheWinner(int n, int k) {
        
         Queue<Integer>q=new LinkedList<>();

         for(int i=1;i<=n;i++){
            q.add(i);
         }
         while(q.size()>1){
            for(int i=1;i<k;i++){
                q.add(q.remove());//first ko hta k last m dalna h jb tk kth mill nhi jata h
            }
            q.remove();//kth removed 

         }
         return q.peek();
    }
}
