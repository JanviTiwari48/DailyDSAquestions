//Leetcode ques-Time Needed to Buy Tickets

class Solution {
    public int timeRequiredToBuy(int[] tickets, int k) {
        
        Queue<Integer>q=new LinkedList<>();

        for(int i=0;i<tickets.length;i++){//storing indexes
            q.add(i);
        }
        int seconds=0;

        while(q.size()>0){
            int person=q.remove();

            tickets[person]--;
            seconds++;

            if(tickets[person]==0){
                if(person==k)return seconds;
            }else{
                q.add(person);
            }
        }
        return seconds;

    }
}
